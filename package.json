{
  "name": "shopwave",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ShopWave — a responsive e-commerce store built with React, TypeScript, Vite, and Lottie animations.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "lottie-react": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.6"
  }
}
